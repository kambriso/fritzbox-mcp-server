digraph G {
  rankdir=TB;
  bgcolor="#1e1e1e";
  fontname="Helvetica";
  node [fontname="Helvetica", shape=box, style="filled", color="#000000", penwidth=2];
  edge [fontname="Helvetica", color="#cfcfcf", penwidth=2];

  // INTERNET / CLOUD
  subgraph cluster_cloud {
    label="INTERNET / CLOUD";
    style="rounded,filled";
    color="#ff4d4d";
    fillcolor="#3a1a1a";
    fontcolor="#ffb3b3";

    ai [label="AI Service\n(Anthropic, OpenAI, etc.)", fillcolor="#d84a4a", fontcolor="white", color="#b03030"];
    isp [label="Your ISP\n(Internet connection)", fillcolor="#d84a4a", fontcolor="white", color="#b03030"];
  }

  // YOUR HOME NETWORK - Exposed
  subgraph cluster_exposed {
    label="Internet-Exposed Components";
    style="rounded,filled";
    color="#ff9c2a";
    fillcolor="#3a2a12";
    fontcolor="#ffd3a1";

    agent [label="AI Agent\n(Claude, GPT4all, LM Studio, ...)", fillcolor="#ffb35a", fontcolor="#1a1a1a", color="#cc7a10"];
    fritz [label="FRITZ!Box\nYour router", fillcolor="#ffb35a", fontcolor="#1a1a1a", color="#cc7a10"];
  }

  // YOUR HOME NETWORK - Local
  subgraph cluster_local {
    label="100% Local";
    style="rounded,filled";
    color="#3fbf66";
    fillcolor="#14301d";
    fontcolor="#b8f2c8";

    llm [label="Local LLM", fillcolor="#8fe0a6", fontcolor="#0f2416", color="#2a8d4a"];
    mcp [label="FRITZ!Box MCP Server\n+ Your FRITZ!Box Credentials", fillcolor="#8fe0a6", fontcolor="#0f2416", color="#2a8d4a"];
  }

  ai -> agent  [fontcolor="#cfcfcf", dir="both"];
  isp -> fritz [fontcolor="#cfcfcf", dir="both"];
  agent -> mcp [fontcolor="#cfcfcf", dir="both"];
  agent -> llm [fontcolor="#cfcfcf", dir="both"];
  fritz -> mcp [fontcolor="#cfcfcf", dir="both"];
}

